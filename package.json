{
  "name": "kn-lan-share",
  "version": "0.1.5",
  "type": "module",
  "main": "./dist/server.js",
  "description": "Lightweight HTTP server for local file sharing across your network with QR code access, upload/download capabilities, and smart network detection",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.ts",
    "!dist/**/*.d.ts",
    "public",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "preview": "node dist/server.js"
  },
  "bin": {
    "kls": "dist/server.js"
  },
  "keywords": [
    "kn lan share",
    "cli lan share",
    "http server",
    "file transfer",
    "lan share",
    "file sharing",
    "file transfer",
    "network share",
    "static server",
    "file upload",
    "file download",
    "local server"
  ],
  "author": {
    "name": "knkrn5"
  },
  "homepage": "https://github.com/knkrn5/kn-lan-share#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knkrn5/kn-lan-share.git"
  },
  "bugs": {
    "url": "https://github.com/knkrn5/kn-lan-share/issues"
  },
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  }
}
